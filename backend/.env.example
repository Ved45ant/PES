# MongoDB connection string
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/your_database

# JWT secret key used for signing auth tokens and PDF tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Server port (optional, defaults to 5000)
PORT=5000

# Frontend URL for CORS and redirect links (optional, defaults to http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Gmail credentials used by email.ts (sendReminderEmail, sendTicketResolvedEmail)
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Gmail credentials used by auth.controller.ts (OTP emails)
# These can be the same as EMAIL_USER / EMAIL_PASS
MAIL_SENDER=youremail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
